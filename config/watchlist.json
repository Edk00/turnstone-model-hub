      { "base": "moonshotai/Kimi-Linear-48B-A3B-Instruct",  "family": "kimi",     "note": "Kimi's small hybrid-attention MoE; check llama.cpp support of the GGUF." },
      { "base": "zai-org/GLM-4.7-Flash",                    "family": "glm",      "note": "31B; strong coder/agent, ~19 GB at 4-bit." },
      { "base": "zai-org/GLM-4.5-Air",                      "family": "glm",      "note": "110B MoE (12B active); ~65 GB at 4-bit." },
