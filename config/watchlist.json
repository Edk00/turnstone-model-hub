      { "base": "MiniMaxAI/MiniMax-M2.7",                   "family": "minimax",  "note": "229B MoE (~10B active); ~95 GB at ~3-bit." },
      { "base": "stepfun-ai/Step-3.5-Flash",                "family": "step",     "note": "199B MoE; ~85 GB at ~3-bit." },
      { "base": "inclusionAI/Ling-3.0-flash",               "family": "ling",     "note": "127B MoE; ~75 GB at 4-bit." },
      { "base": "tencent/Hunyuan-A13B-Instruct",            "family": "hunyuan",  "note": "80B MoE (13B active); ~48 GB at 4-bit." },
      { "base": "baidu/ERNIE-4.5-21B-A3B-Thinking",         "family": "ernie",    "note": "21B MoE reasoning model; small and fast." },
      { "base": "ibm-granite/granite-4.1-30b",              "family": "granite",  "note": "30B dense, enterprise-oriented, tool calling." },
      { "base": "XiaomiMiMo/MiMo-V2.5",                     "family": "mimo",     "note": "311B MoE; too large except at very low quant." }
